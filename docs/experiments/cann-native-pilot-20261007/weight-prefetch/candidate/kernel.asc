#include <cstdint>
#include <limits>
#include "kernel_operator.h"

// Candidate v2 for the supplied CANN 9.0 / dav-2201 direct-launch scaffold.
// Numerical target: supplied AddRmsNormBias.py (FP32 throughout, one final cast).
// This file is included by main.asc. It intentionally defines no main / guard.
// Status: source-reviewed; not compiled or executed on an Ascend NPU here.

namespace add_rms_norm_bias_v1 {

constexpr uint32_t kTileLimit = 2048;
constexpr uint32_t kCacheLimit = 8192;
constexpr uint32_t kNativeCacheLimit = 16384;
constexpr uint32_t kMaxDim = 32768;

template <typename T>
__aicore__ inline void ToFloat(const AscendC::LocalTensor<float>& dst,
                              const AscendC::LocalTensor<T>& src,
                              uint32_t count)
{
    AscendC::Cast(dst, src, AscendC::RoundMode::CAST_NONE, count);
}

template <>
__aicore__ inline void ToFloat<float>(const AscendC::LocalTensor<float>& dst,
                                     const AscendC::LocalTensor<float>& src,
                                     uint32_t count)
{
    // UB-to-UB DataCopy requires a multiple of 32 bytes. Both allocations
    // include this padding; padding is never counted in the row reduction.
    AscendC::DataCopy(dst, src, (count + 7U) / 8U * 8U);
}

template <typename T>
__aicore__ inline void FromFloat(const AscendC::LocalTensor<T>& dst,
                                const AscendC::LocalTensor<float>& src,
                                uint32_t count)
{
    AscendC::Cast(dst, src, AscendC::RoundMode::CAST_RINT, count);
}

template <>
__aicore__ inline void FromFloat<float>(const AscendC::LocalTensor<float>& dst,
                                       const AscendC::LocalTensor<float>& src,
                                       uint32_t count)
{
    // Do not use Cast<float, float>: its rounding modes round to integers.
    AscendC::DataCopy(dst, src, (count + 7U) / 8U * 8U);
}

template <typename T>
class Kernel {
public:
    __aicore__ inline Kernel() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
                               GM_ADDR bias, GM_ADDR output, int64_t rows,
                               uint32_t dim, float dimFloat, uint32_t rowGroup, float epsilon)
    {
        rows_ = rows;
        dim_ = dim;
        dimFloat_ = dimFloat;
        epsilon_ = epsilon;
        paddedDim_ = (dim + 15U) / 16U * 16U;
        tile_ = (dim + 63U) / 64U * 64U;
        if (tile_ > kTileLimit) {
            tile_ = kTileLimit;
        }
        tileCount_ = (dim + tile_ - 1U) / tile_;
        partialCount_ = (tileCount_ + 7U) / 8U * 8U;

        // Whole row groups are assigned to a core. Core boundaries therefore
        // fall on a 32-byte output boundary, even for an odd hidden dimension.
        const int64_t groups = (rows + rowGroup - 1) / rowGroup;
        const int64_t cores = static_cast<int64_t>(AscendC::GetBlockNum());
        const int64_t core = static_cast<int64_t>(AscendC::GetBlockIdx());
        const int64_t base = groups / cores;
        const int64_t remainder = groups % cores;
        const int64_t firstGroup = core * base + (core < remainder ? core : remainder);
        const int64_t ownedGroups = base + (core < remainder ? 1 : 0);
        firstRow_ = firstGroup * rowGroup;
        endRow_ = (firstGroup + ownedGroups) * rowGroup;
        if (endRow_ > rows_) {
            endRow_ = rows_;
        }

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        residualGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(residual));
        gammaGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma));
        biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bias));
        outputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output));

        const uint32_t typeBytes = static_cast<uint32_t>(sizeof(T));
        cacheWeights_ = dim_ <= kCacheLimit;
        cacheNativeWeights_ = sizeof(T) == 2 && dim_ > kCacheLimit &&
                              dim_ <= kNativeCacheLimit && (endRow_ - firstRow_) >= 2;
        const uint32_t weightBytes = cacheWeights_ ? 2U * paddedDim_ * sizeof(float) :
            (cacheNativeWeights_ ? 2U * paddedDim_ * typeBytes : 0U);
        const uint32_t singleUbBytes = 3U * tile_ * typeBytes +
            paddedDim_ * sizeof(float) + 3U * tile_ * sizeof(float) +
            partialCount_ * sizeof(float) + 32U + 256U + weightBytes;
        prefetchInput_ = tileCount_ > 1 &&
                         singleUbBytes + 2U * tile_ * typeBytes <= 180576U;
        pipe_.InitBuffer(inputQueue_, prefetchInput_ ? 2 : 1, 2U * tile_ * typeBytes);
        pipe_.InitBuffer(outputQueue_, 1, tile_ * typeBytes);
        pipe_.InitBuffer(yBuffer_, paddedDim_ * sizeof(float));
        pipe_.InitBuffer(tempBuffer_, 2U * tile_ * sizeof(float));
        pipe_.InitBuffer(rmsBuffer_, tile_ * sizeof(float));
        pipe_.InitBuffer(partialBuffer_, partialCount_ * sizeof(float));
        pipe_.InitBuffer(statBuffer_, 32);
        // High-dimensional ReduceSum needs at most ceil(32 / 8) * 8 floats
        // for a tile of 2048 FP32 values. 256 bytes includes spare capacity.
        pipe_.InitBuffer(reduceBuffer_, 256);
        if (cacheWeights_) {
            pipe_.InitBuffer(weightBuffer_, 2U * paddedDim_ * sizeof(float));
        } else if (cacheNativeWeights_) {
            pipe_.InitBuffer(weightBuffer_, 2U * paddedDim_ * typeBytes);
        }

        y_ = yBuffer_.Get<float>();
        temp0_ = tempBuffer_.Get<float>();
        temp1_ = temp0_[tile_];
        rmsVector_ = rmsBuffer_.Get<float>();
        partials_ = partialBuffer_.Get<float>();
        stats_ = statBuffer_.Get<float>();
        reduceWork_ = reduceBuffer_.Get<float>();
        if (cacheWeights_) {
            gammaCache_ = weightBuffer_.Get<float>();
            biasCache_ = gammaCache_[paddedDim_];
        } else if (cacheNativeWeights_) {
            nativeGammaCache_ = weightBuffer_.Get<T>();
            nativeBiasCache_ = nativeGammaCache_[paddedDim_];
        }
    }

    __aicore__ inline void Process()
    {
        if (firstRow_ >= endRow_) {
            return;
        }
        if (cacheWeights_) {
            CacheWeights();
        } else if (cacheNativeWeights_) {
            CacheNativeWeights();
        }
        for (int64_t row = firstRow_; row < endRow_; ++row) {
            const int64_t rowOffset = row * static_cast<int64_t>(dim_);
            ComputeRowSum(rowOffset);
            ComputeRms();
            WriteRow(rowOffset);
        }
    }

private:
    __aicore__ inline uint32_t ValidCount(uint32_t offset) const
    {
        const uint32_t remaining = dim_ - offset;
        return remaining < tile_ ? remaining : tile_;
    }

    __aicore__ inline void EnqueuePair(
        AscendC::GlobalTensor<T>& first, AscendC::GlobalTensor<T>& second,
        int64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> packed = inputQueue_.AllocTensor<T>();
        const uint32_t bytes = count * static_cast<uint32_t>(sizeof(T));
        const uint32_t paddedBytes = (bytes + 31U) / 32U * 32U;
        AscendC::DataCopyExtParams copyParams{1, bytes, 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{
            true, 0,
            static_cast<uint8_t>((paddedBytes - bytes) / sizeof(T)),
            static_cast<T>(0.0f)};
        AscendC::DataCopyPad(packed, first[offset], copyParams, padParams);
        AscendC::DataCopyPad(packed[tile_], second[offset], copyParams, padParams);
        inputQueue_.EnQue<T>(packed);
    }

    __aicore__ inline AscendC::LocalTensor<T> LoadPair(
        AscendC::GlobalTensor<T>& first, AscendC::GlobalTensor<T>& second,
        int64_t offset, uint32_t count)
    {
        EnqueuePair(first, second, offset, count);
        return inputQueue_.DeQue<T>();
    }

    __aicore__ inline void CacheWeights()
    {
        for (uint32_t offset = 0; offset < dim_; offset += tile_) {
            const uint32_t count = ValidCount(offset);
            AscendC::LocalTensor<T> packed = LoadPair(gammaGm_, biasGm_, offset, count);
            ToFloat<T>(gammaCache_[offset], packed, count);
            ToFloat<T>(biasCache_[offset], packed[tile_], count);
            AscendC::PipeBarrier<PIPE_V>();
            inputQueue_.FreeTensor(packed);
        }
    }

    __aicore__ inline void CacheNativeWeights()
    {
        for (uint32_t offset = 0; offset < dim_; offset += tile_) {
            const uint32_t count = ValidCount(offset);
            const uint32_t typeBytes = static_cast<uint32_t>(sizeof(T));
            // Copy complete 32-byte blocks, including LoadPair's zero padding.
            // The padded count fits both the source tile and paddedDim_.
            const uint32_t copyCount = (count * typeBytes + 31U) / 32U * 32U / typeBytes;
            AscendC::LocalTensor<T> packed = LoadPair(gammaGm_, biasGm_, offset, count);
            AscendC::DataCopy(nativeGammaCache_[offset], packed, copyCount);
            AscendC::DataCopy(nativeBiasCache_[offset], packed[tile_], copyCount);
            AscendC::PipeBarrier<PIPE_V>();
            inputQueue_.FreeTensor(packed);
        }
    }

    __aicore__ inline void ComputeRowSum(int64_t rowOffset)
    {
        AscendC::Duplicate(partials_, 0.0f, partialCount_);
        AscendC::PipeBarrier<PIPE_V>();
        if (prefetchInput_) {
            EnqueuePair(xGm_, residualGm_, rowOffset, ValidCount(0));
        }
        for (uint32_t index = 0; index < tileCount_; ++index) {
            const uint32_t offset = index * tile_;
            const uint32_t count = ValidCount(offset);
            AscendC::LocalTensor<T> packed;
            if (prefetchInput_) {
                packed = inputQueue_.DeQue<T>();
                if (index + 1U < tileCount_) {
                    const uint32_t nextOffset = (index + 1U) * tile_;
                    EnqueuePair(xGm_, residualGm_, rowOffset + nextOffset,
                                ValidCount(nextOffset));
                }
            } else {
                packed = LoadPair(xGm_, residualGm_, rowOffset + offset, count);
            }
            ToFloat<T>(temp0_, packed, count);
            ToFloat<T>(temp1_, packed[tile_], count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(y_[offset], temp0_, temp1_, count);
            AscendC::PipeBarrier<PIPE_V>();
            inputQueue_.FreeTensor(packed);

            const uint32_t reduceCount = (count + 63U) / 64U * 64U;
            // Zero the square-buffer padding. Inputs are never read beyond
            // their valid extent; padding contributes zero to the reduction.
            if (reduceCount != count) {
                AscendC::Duplicate(temp0_, 0.0f, reduceCount);
                AscendC::PipeBarrier<PIPE_V>();
            }
            AscendC::Mul(temp0_, y_[offset], y_[offset], count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::ReduceSum<float>(
                partials_[index], temp0_, reduceWork_, 64,
                static_cast<int32_t>(reduceCount / 64U), 8);
            AscendC::PipeBarrier<PIPE_V>();
        }
    }

    __aicore__ inline void ComputeRms()
    {
        AscendC::ReduceSum<float>(stats_, partials_, reduceWork_,
                                  static_cast<int32_t>(tileCount_));
        AscendC::Duplicate(rmsVector_, dimFloat_, 8);
        AscendC::PipeBarrier<PIPE_V>();
        // Keep the reference ordering: sum / D, then + epsilon, then sqrt.
        AscendC::Div(stats_, stats_, rmsVector_, 1);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(stats_, stats_, epsilon_, 1);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sqrt(stats_, stats_, 1);
        const auto event = pipe_.FetchEventID(AscendC::HardEvent::V_S);
        AscendC::SetFlag<AscendC::HardEvent::V_S>(event);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(event);
        rms_ = stats_.GetValue(0);
        const auto bits = stats_.ReinterpretCast<uint32_t>();
        rmsBits_ = bits.GetValue(0) & 0x7fffffffU;
        AscendC::Duplicate(rmsVector_, rms_, tile_);
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void WriteRow(int64_t rowOffset)
    {
        const bool prefetchWeights = prefetchInput_ && !cacheWeights_ && !cacheNativeWeights_;
        if (prefetchWeights) {
            EnqueuePair(gammaGm_, biasGm_, 0, ValidCount(0));
        }
        for (uint32_t offset = 0; offset < dim_; offset += tile_) {
            const uint32_t count = ValidCount(offset);
            AscendC::LocalTensor<float> gamma = temp0_;
            AscendC::LocalTensor<float> bias = temp1_;
            if (cacheWeights_) {
                gamma = gammaCache_[offset];
                bias = biasCache_[offset];
            } else if (cacheNativeWeights_) {
                ToFloat<T>(temp0_, nativeGammaCache_[offset], count);
                ToFloat<T>(temp1_, nativeBiasCache_[offset], count);
                AscendC::PipeBarrier<PIPE_V>();
            } else {
                AscendC::LocalTensor<T> packed;
                if (prefetchWeights) {
                    packed = inputQueue_.DeQue<T>();
                    const uint32_t nextOffset = offset + tile_;
                    if (nextOffset < dim_) {
                        EnqueuePair(gammaGm_, biasGm_, nextOffset, ValidCount(nextOffset));
                    }
                } else {
                    packed = LoadPair(gammaGm_, biasGm_, offset, count);
                }
                ToFloat<T>(temp0_, packed, count);
                ToFloat<T>(temp1_, packed[tile_], count);
                AscendC::PipeBarrier<PIPE_V>();
                inputQueue_.FreeTensor(packed);
                gamma = temp0_;
                bias = temp1_;
            }

            if (rmsBits_ > 0x7f800000U) {
                // A NaN in the residual sum contaminates the complete row.
                AscendC::Duplicate(y_[offset], rms_, count);
            } else if (rmsBits_ == 0x7f800000U) {
                // finite / +Inf -> signed zero; +/-Inf / +Inf -> NaN.
                AscendC::Muls(y_[offset], y_[offset], 0.0f, count);
            } else {
                AscendC::Div(y_[offset], y_[offset], rmsVector_, count);
            }
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(y_[offset], y_[offset], gamma, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(y_[offset], y_[offset], bias, count);
            AscendC::PipeBarrier<PIPE_V>();

            AscendC::LocalTensor<T> out = outputQueue_.AllocTensor<T>();
            FromFloat<T>(out, y_[offset], count);
            outputQueue_.EnQue<T>(out);
            out = outputQueue_.DeQue<T>();
            AscendC::DataCopyExtParams copyParams{
                1, count * static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPad(outputGm_[rowOffset + offset], out, copyParams);
            outputQueue_.FreeTensor(out);
        }
    }

    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inputQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> yBuffer_, tempBuffer_, rmsBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> partialBuffer_, statBuffer_, reduceBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> weightBuffer_;
    AscendC::GlobalTensor<T> xGm_, residualGm_, gammaGm_, biasGm_, outputGm_;
    AscendC::LocalTensor<float> y_, temp0_, temp1_, rmsVector_;
    AscendC::LocalTensor<float> partials_, stats_, reduceWork_, gammaCache_, biasCache_;
    int64_t rows_, firstRow_, endRow_;
    uint32_t dim_, paddedDim_, tile_, tileCount_, partialCount_, rmsBits_;
    float epsilon_, rms_, dimFloat_;
    AscendC::LocalTensor<T> nativeGammaCache_, nativeBiasCache_;
    bool cacheWeights_, cacheNativeWeights_, prefetchInput_;
};

template <typename T>
__global__ __vector__ void DeviceKernel(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    int64_t rows, uint32_t dim, float dimFloat, uint32_t rowGroup, float epsilon)
{
    Kernel<T> kernel;
    kernel.Init(x, residual, gamma, bias, output, rows, dim, dimFloat, rowGroup, epsilon);
    kernel.Process();
}

inline uint32_t Gcd(uint32_t a, uint32_t b)
{
    while (b != 0) {
        const uint32_t remainder = a % b;
        a = b;
        b = remainder;
    }
    return a;
}

inline bool SameShape(const TensorInfo& lhs, const TensorInfo& rhs)
{
    if (lhs.numDims != rhs.numDims || lhs.dtype != rhs.dtype ||
        lhs.shape == nullptr || rhs.shape == nullptr) {
        return false;
    }
    for (int64_t i = 0; i < lhs.numDims; ++i) {
        if (lhs.shape[i] != rhs.shape[i]) {
            return false;
        }
    }
    return true;
}

} // namespace add_rms_norm_bias_v1

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR residual, const TensorGroupInfo& info_residual,
    GM_ADDR gamma, const TensorGroupInfo& info_gamma,
    GM_ADDR bias, const TensorGroupInfo& info_bias,
    GM_ADDR output, const TensorGroupInfo& info_output,
    int64_t availableCoreNum, aclrtStream stream, float epsilon)
{
    using namespace add_rms_norm_bias_v1;
    if (info_x.numTensors != 1 || info_residual.numTensors != 1 ||
        info_gamma.numTensors != 1 || info_bias.numTensors != 1 ||
        info_output.numTensors != 1 || info_x.tensors == nullptr ||
        info_residual.tensors == nullptr || info_gamma.tensors == nullptr ||
        info_bias.tensors == nullptr || info_output.tensors == nullptr ||
        availableCoreNum <= 0) {
        return;
    }
    const TensorInfo& xi = info_x.tensors[0];
    const TensorInfo& gi = info_gamma.tensors[0];
    const TensorInfo& bi = info_bias.tensors[0];
    if (xi.shape == nullptr || xi.numDims < 2 || xi.numDims > 4 ||
        xi.dtype < 0 || xi.dtype > 2 ||
        !SameShape(xi, info_residual.tensors[0]) ||
        !SameShape(xi, info_output.tensors[0]) ||
        gi.shape == nullptr || bi.shape == nullptr ||
        gi.numDims != 1 || bi.numDims != 1 ||
        gi.dtype != xi.dtype || bi.dtype != xi.dtype) {
        return;
    }
    const int64_t dim64 = xi.shape[xi.numDims - 1];
    // D<64 is accepted as well, because the statement/examples include it.
    if (dim64 <= 0 || dim64 > kMaxDim || gi.shape[0] != dim64 || bi.shape[0] != dim64) {
        return;
    }
    int64_t rows = 1;
    for (int64_t i = 0; i + 1 < xi.numDims; ++i) {
        if (xi.shape[i] <= 0 ||
            rows > std::numeric_limits<int64_t>::max() / xi.shape[i]) {
            return;
        }
        rows *= xi.shape[i];
    }
    const uint32_t dim = static_cast<uint32_t>(dim64);
    // Convert on the host: aicore rejects a dynamic uint32_t-to-float cast.
    const float dimFloat = static_cast<float>(dim);
    const uint32_t typeBytes = xi.dtype == 0 ? 4U : 2U;
    if (rows > std::numeric_limits<int64_t>::max() / (dim64 * typeBytes)) {
        return;
    }
    const uint32_t rowGroup = 32U / Gcd(dim * typeBytes, 32U);
    const int64_t groups = (rows + rowGroup - 1) / rowGroup;
    const uint32_t blocks = static_cast<uint32_t>(
        groups < availableCoreNum ? groups : availableCoreNum);
    if (xi.dtype == 0) {
        DeviceKernel<float><<<blocks, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, dim, dimFloat, rowGroup, epsilon);
    } else if (xi.dtype == 1) {
        DeviceKernel<half><<<blocks, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, dim, dimFloat, rowGroup, epsilon);
    } else {
        DeviceKernel<bfloat16_t><<<blocks, nullptr, stream>>>(
            x, residual, gamma, bias, output, rows, dim, dimFloat, rowGroup, epsilon);
    }
}
