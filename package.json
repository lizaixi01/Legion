{
  "name": "legion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "legion": "bin/legion.cjs"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "demo": "tsx src/cli.ts demo",
    "demo:goal": "tsx src/cli.ts demo-goal",
    "team": "tsx src/team-cli.ts",
    "demo:team": "tsx src/team-cli.ts demo",
    "ui": "tsx src/ui-server.ts",
    "desktop": "npm run build && node desktop/launch.cjs",
    "benchmark": "tsx src/benchmark-cli.ts",
    "saasbench": "tsx src/saasbench-cli.ts",
    "research": "tsx src/research-cli.ts",
    "dist": "npm run build && electron-builder --win nsis",
    "demo:acceptance": "tsx src/acceptance-demo.ts",
    "smoke:acceptance": "tsx src/acceptance-smoke.ts",
    "engineering": "npm run build && node dist/src/engineering-run-cli.js",
    "demo:resume": "tsx src/engineering-resume-demo.ts",
    "smoke:resume": "npm run build && node dist/src/engineering-run-cli.js smoke"
  },
  "build": {
    "appId": "local.legion",
    "productName": "Legion",
    "directories": {
      "output": "dist-release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Legion",
      "artifactName": "Legion-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
